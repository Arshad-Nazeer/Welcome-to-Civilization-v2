# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
ENV/
env/

# Large Data files (raw, processed, splits, manual downloads)
data/raw/*
!data/raw/.gitkeep
!data/raw/raw_manifest.json
data/processed/*
!data/processed/.gitkeep
!data/processed/DATA_DICTIONARY.md
!data/processed/qa_report.json
data/splits/*
!data/splits/.gitkeep
!data/splits/*.json
!data/splits/v1_exact_dup/
!data/splits/v1_exact_dup/*.json
data/raw/kaggle_manual/
*.parquet
*.csv.zip
*.zip
*.csv

# External assets (e.g. fastText pretrained embeddings)
external/
external/**

# Reports: keep dedup outputs, ignore large EDA files only
reports/eda/figures/*.png
reports/eda/tables/*.csv
!reports/dedup/

# Allow predictions, reports, visualizations to be tracked
!predictions/**
!reports/**
!visualizations/**

# Model weights & caches (ignore large binaries, allow metadata and status)
models/**/*.joblib
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/*.onnx
models/**/*.npy

# Smoke test outputs
*_smoke/
*_smoke/**

# Local backups from pipeline development
backup_*/

# Logs & Training runs
logs/*
!logs/.gitkeep
runs/*
!runs/.gitkeep
*.log

# Testing & Caches
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# OS & IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Credentials & secrets
kaggle.json
*.key
*.pem
.env
